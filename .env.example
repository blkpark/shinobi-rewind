# Demo mode requires no credentials and is the default.
DEMO_MODE=true
LISTEN_ADDR=:8080
SHINOBI_REWIND_BIND_IP=127.0.0.1
SHINOBI_REWIND_PORT=8092

# Optional writable directory for verified favorite archives. Leave empty to disable.
# ARCHIVE_ROOT=/archive

# Set DEMO_MODE=false for a read-only Shinobi connection. Keep this file free of values.
# SHINOBI_URL=http://shinobi:8080
# SHINOBI_GROUP_KEY=
# SHINOBI_API_KEY=
